{
  "name": "stacksindex-root",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for stacksindex",
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run readme:check && vp run -r test && vp run -r build",
    "repos:sync": "./scripts/sync-repos.sh",
    "readme:sync": "./scripts/sync-readme.sh",
    "readme:check": "./scripts/sync-readme.sh --check",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint",
    "changeset": "changeset",
    "version": "changeset version && vp check --fix",
    "release": "vp run build && vp run readme:sync && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.48.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.10.1"
}
