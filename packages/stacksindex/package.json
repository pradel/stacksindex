    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@stacks/blockchain-api-client": "9.0.2",
    "@stacks/codec": "2.1.0",
    "@stacks/transactions": "7.6.0",
    "better-result": "3.0.1",
    "clarity-abitype": "0.7.1",
    "consola": "3.4.2",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.0.0"
