{
  "name": "stacksindex",
  "version": "0.0.1",
  "description": "A simple, open-source historical indexer for the Stacks blockchain.",
  "homepage": "https://github.com/pradel/stacksindex#readme",
  "bugs": {
    "url": "https://github.com/pradel/stacksindex/issues"
  },
  "license": "MIT",
  "author": "Léo Pradel <pradel.leo@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pradel/stacksindex.git"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
